# Copie este arquivo para .env (dentro da pasta backend) e preencha com os valores reais

# String de conexão com o banco MySQL local
# Formato: mysql+pymysql://usuario:senha@localhost/nome_do_banco
DATABASE_URL="mysql+pymysql://root:sua_senha_aqui@localhost/conecta_bairro"

# Chave usada para gerar tokens de autenticação - pode ser qualquer texto secreto
SECRET_KEY="crie-uma-chave-secreta-qualquer-aqui"

# Client ID do Google OAuth (peça para Jamile)
GOOGLE_CLIENT_ID=849442096383-abc.apps.googleusercontent.com